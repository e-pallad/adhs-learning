// Devfluent — ADHD-friendly developer learning tracker
// Multi-user ready (single-user now, userId on every model)

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum NodeStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum BlockStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  avatarUrl  String?
  totalXP    Int       @default(0)
  level      Int       @default(1)
  streak             Int       @default(0)
  track              String    @default("javascript")
  dailyGoalBlocks    Int       @default(3)
  weeklyGoalBlocks   Int       @default(10)
  lastSeenAt         DateTime?
  streakFreezeUsedAt DateTime?
  githubUsername     String?
  githubAccessToken  String?
  githubLastSyncAt   DateTime?
  apiKey             String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  dailyLogs          DailyLog[]
  roadmapProgress    RoadmapProgress[]
  blockProgress      BlockProgress[]
  externalCourses    ExternalCourse[]
  monthlyProjects    MonthlyProject[]
  achievements       Achievement[]
  quizAttempts       QuizAttempt[]
  githubEvents       GithubEvent[]
  aiRecommendation   AiRecommendation?
  sentPairs          AccountabilityPair[] @relation("RequesterPairs")
  receivedPairs      AccountabilityPair[] @relation("PartnerPairs")

  @@map("users")
}

// ─── Daily Log ───────────────────────────────────────────────────────────────

model DailyLog {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date
  xpEarned        Int      @default(0)
  minutesStudied  Int      @default(0)
  blocksCompleted Int      @default(0)
  streakDay       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_logs")
}

// ─── Roadmap Progress ────────────────────────────────────────────────────────

model RoadmapProgress {
  id          String     @id @default(cuid())
  userId      String
  roadmapId   String
  nodeId      String
  nodeLabel   String
  nodeType    String
  status      NodeStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId, nodeId])
  @@map("roadmap_progress")
}

// ─── Learning Block Progress ─────────────────────────────────────────────────

model BlockProgress {
  id           String      @id @default(cuid())
  userId       String
  blockId      String
  month        Int
  week         Int
  status       BlockStatus @default(NOT_STARTED)
  minutesSpent Int         @default(0)
  xpEarned     Int         @default(0)
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockId])
  @@map("block_progress")
}

// ─── External Courses ────────────────────────────────────────────────────────

model ExternalCourse {
  id               String    @id @default(cuid())
  userId           String
  title            String
  platform         String
  url              String?
  totalLessons     Int       @default(0)
  completedLessons Int       @default(0)
  xpEarned         Int       @default(0)
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("external_courses")
}

// ─── Monthly Projects ────────────────────────────────────────────────────────

model MonthlyProject {
  id          String        @id @default(cuid())
  userId      String
  track       String        @default("javascript")
  month       Int
  title       String
  description String?
  repoUrl     String?
  liveUrl     String?
  status      ProjectStatus @default(NOT_STARTED)
  xpEarned    Int           @default(0)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, track, month])
  @@map("monthly_projects")
}

// ─── Achievements ─────────────────────────────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  slug        String
  label       String
  description String?
  icon        String?
  xpBonus     Int      @default(0)
  unlockedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@map("achievements")
}

// ─── Quiz Attempts ────────────────────────────────────────────────────────────

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockId     String
  score       Int      // 0-100
  passed      Boolean
  perfect     Boolean
  xpEarned    Int      @default(0)
  attemptedAt DateTime @default(now())

  @@index([userId, blockId])
}

// ─── AI Recommendations ──────────────────────────────────────────────────────

model AiRecommendation {
  id          String   @id @default(cuid())
  userId      String   @unique
  content     String
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_recommendations")
}

// ─── Accountability Pairs ─────────────────────────────────────────────────────

model AccountabilityPair {
  id          String   @id @default(cuid())
  requesterId String
  partnerId   String
  createdAt   DateTime @default(now())

  requester User @relation("RequesterPairs", fields: [requesterId], references: [id], onDelete: Cascade)
  partner   User @relation("PartnerPairs",   fields: [partnerId],   references: [id], onDelete: Cascade)

  @@unique([requesterId, partnerId])
  @@map("accountability_pairs")
}

// ─── GitHub Events ────────────────────────────────────────────────────────────

model GithubEvent {
  id         String   @id @default(cuid())
  userId     String
  eventId    String   // GitHub event ID
  eventType  String   // PushEvent, PullRequestEvent, etc.
  xpAwarded  Int
  occurredAt DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("github_events")
}
